---
/*
  Chapter.astro — a chapter of the long read.
  Standard chapters: two columns on desktop — a sticky (pinned) figure beside
  scrolling prose. On mobile this degrades to figure-then-text stacked blocks,
  with no pinning.
  Chapter 05 is special: it has four sub-blocks, each its own intuition →
  real-name → figure row, rendered in an alternating layout.
*/
import Figure from './Figure.astro';
import type { Chapter } from '../content/chapters';

interface Props {
  chapter: Chapter;
}
const { chapter } = Astro.props;
const leanClass = chapter.lean ? `lean-${chapter.lean}` : '';
---

<section class={`chapter ${leanClass}`} id={chapter.id} data-chapter aria-labelledby={`${chapter.id}-h`}>
  <div class="chapter__head">
    <p class="chapter__kicker spec">
      <span class="chapter__num mono">{chapter.num}</span>
      {chapter.kicker}
    </p>
    <h2 id={`${chapter.id}-h`} class="chapter__title">{chapter.title}</h2>
    {chapter.dek && <p class="chapter__dek">{chapter.dek}</p>}
  </div>

  {
    chapter.subBlocks ? (
      <div class="chapter__intro">
        {chapter.body.map((p) => (
          <p set:html={p} />
        ))}
      </div>
      <div class="subblocks">
        {chapter.subBlocks.map((sb, i) => (
          <div class={`subblock ${i % 2 === 1 ? 'subblock--alt' : ''}`}>
            <div class="subblock__text">
              <p class="subblock__intuition">{sb.intuition}</p>
              <p class="subblock__realname spec">→ {sb.realName}</p>
              <p set:html={sb.body} />
            </div>
            {sb.figure && (
              <div class="subblock__fig">
                <Figure figure={sb.figure} ratio="4 / 3" />
              </div>
            )}
          </div>
        ))}
      </div>
    ) : (
      <div class="chapter__body">
        {chapter.figure && (
          <div class="chapter__viz">
            <div class="chapter__viz-sticky">
              <Figure figure={chapter.figure} />
            </div>
          </div>
        )}
        <div class="chapter__prose">
          {chapter.body.map((p) => (
            <p set:html={p} />
          ))}
          {chapter.sideNote && (
            <aside class="sidenote">
              <p class="sidenote__label spec">{chapter.sideNote.label}</p>
              <p class="sidenote__body" set:html={chapter.sideNote.body} />
            </aside>
          )}
        </div>
      </div>
    )
  }
</section>

<style>
  .chapter {
    padding: var(--space-7) var(--space-5);
    border-bottom: 1px solid var(--hairline);
    position: relative;
  }

  /* The accent seam: a thin top rule tinted by the chapter's lean. */
  .chapter::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: clamp(80px, 18%, 240px);
    height: 2px;
    background: var(--graphite);
  }
  .chapter.lean-silicon::before { background: var(--phosphor); }
  .chapter.lean-bio::before { background: var(--synapse); }
  .chapter.lean-oversight::before { background: var(--oversight); }

  .chapter__head {
    max-width: var(--measure);
    margin-bottom: var(--space-5);
  }
  .chapter__kicker {
    display: flex;
    align-items: baseline;
    gap: 0.8em;
    margin-bottom: var(--space-3);
    color: var(--bone-dim);
  }
  .chapter__num {
    color: var(--graphite);
    font-size: var(--step-0);
  }
  .lean-silicon .chapter__num { color: var(--phosphor); }
  .lean-bio .chapter__num { color: var(--synapse); }

  .chapter__title {
    font-size: var(--step-3);
  }
  .chapter__dek {
    font-size: var(--step-1);
    color: var(--bone);
    font-style: italic;
    max-width: var(--measure);
  }

  /* --- Standard two-column body: sticky figure + scrolling prose --- */
  .chapter__body {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: var(--space-6);
    align-items: start;
  }
  .chapter__viz-sticky {
    position: sticky;
    top: var(--space-5);
  }
  .chapter__prose p {
    font-size: var(--step-0);
  }
  .chapter__prose {
    padding-top: var(--space-2);
  }

  /* Put the figure on the left, prose on the right, on desktop. */
  .chapter__viz { order: 1; }
  .chapter__prose { order: 2; }

  /* --- Side note (myth corrections etc.) --- */
  .sidenote {
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-left: 2px solid var(--synapse);
    background: var(--synapse-dim);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .sidenote__label {
    color: var(--synapse);
    margin-bottom: var(--space-2);
  }
  .sidenote__body {
    margin: 0;
    font-size: var(--step--1);
    line-height: 1.55;
  }

  /* --- Chapter 5 sub-blocks --- */
  .chapter__intro {
    max-width: var(--measure);
    margin-bottom: var(--space-5);
  }
  .subblocks {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .subblock {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-5);
    align-items: center;
  }
  .subblock--alt .subblock__text { order: 2; }
  .subblock--alt .subblock__fig { order: 1; }

  .subblock__intuition {
    font-family: var(--font-body);
    font-size: var(--step-1);
    font-style: italic;
    color: var(--bone);
    margin-bottom: var(--space-2);
  }
  .subblock__realname {
    color: var(--phosphor);
    margin-bottom: var(--space-3);
    text-transform: none;
    letter-spacing: 0.04em;
  }
  .subblock__text p:last-child {
    font-size: var(--step-0);
  }

  /* --- Mobile: everything stacks, nothing pins --- */
  @media (max-width: 60rem) {
    .chapter {
      padding: var(--space-6) var(--space-3);
    }
    .chapter__body {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .chapter__viz-sticky {
      position: static;
    }
    .subblock,
    .subblock--alt {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .subblock__text,
    .subblock--alt .subblock__text,
    .subblock__fig,
    .subblock--alt .subblock__fig {
      order: unset;
    }
  }
</style>
