---
/*
  Figure.astro — the shared frame for every visualization.
  DOM contract (figure modules rely on this):
    .figure__stage[data-figure="<id>"]   <- the mount root
      > canvas.figure__canvas             <- drawing surface
      > .figure__controls[data-controls]  <- module injects controls here
  Caption + a collapsible text description (the reduced-motion / SR fallback)
  sit outside the stage so they read even when JS never runs.
*/
import type { Figure } from '../content/chapters';

interface Props {
  figure: Figure;
  /** aspect-ratio for the stage; tweak per figure where useful */
  ratio?: string;
  /** optional taller aspect-ratio used at mobile widths (dense figures) */
  ratioMobile?: string;
  /** optional instance variant (e.g. hero vs crux) for figures reused in
      more than one place; surfaced to the module as stage.dataset.variant */
  variant?: string;
}
const { figure, ratio = '16 / 10', ratioMobile, variant } = Astro.props;
const ratioVars = `--fig-ratio: ${ratio}; --fig-ratio-m: ${ratioMobile ?? ratio};`;
---

<figure class="figure" id={`fig-${figure.id}-${Math.random().toString(36).slice(2, 7)}`}>
  {figure.spec && <p class="figure__spec spec">{figure.spec}</p>}

  <div
    class="figure__stage"
    data-figure={figure.id}
    data-variant={variant}
    style={ratioVars}
  >
    <div class="figure__surface">
      <canvas class="figure__canvas" aria-hidden="true"></canvas>
      <noscript>
        <p class="figure__noscript mono">
          This figure is interactive and needs JavaScript. The text description below explains what it shows.
        </p>
      </noscript>
    </div>
    <div class="figure__controls" data-controls role="group" aria-label="Figure controls"></div>
  </div>

  <figcaption class="figure__caption">{figure.caption}</figcaption>

  <details class="figure__desc">
    <summary class="mono">Text description of this figure</summary>
    <p>{figure.description}</p>
  </details>
</figure>

<style>
  .figure {
    margin: 0;
    width: 100%;
  }

  .figure__spec {
    margin: 0 0 var(--space-2);
    color: var(--phosphor);
  }

  .figure__stage {
    position: relative;
    width: 100%;
    background: var(--ink-2);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    overflow: hidden;
  }

  /* The drawing surface holds the figure's aspect ratio; the canvas fills it.
     Controls sit below this, in normal flow. */
  .figure__surface {
    position: relative;
    width: 100%;
    aspect-ratio: var(--fig-ratio);
  }

  /* Dense figures can opt into a taller canvas at mobile widths so their
     stacked sections keep room instead of overlapping. */
  @media (max-width: 60rem) {
    .figure__surface {
      aspect-ratio: var(--fig-ratio-m, var(--fig-ratio));
    }
  }

  .figure__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    touch-action: none; /* allow drag interactions without page scroll fighting */
  }

  /* Controls dock beneath the surface rather than overlaying it, so a figure's
     own bottom legends, axes and readouts can never collide with the slider /
     legend bar. */
  .figure__controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    padding: var(--space-2) var(--space-3);
    background: rgba(11, 20, 24, 0.55);
    border-top: 1px solid var(--hairline);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  .figure__controls:empty {
    display: none;
  }

  .figure__noscript {
    position: absolute;
    inset: auto var(--space-3) var(--space-3) var(--space-3);
    color: var(--bone-dim);
  }

  .figure__caption {
    margin: var(--space-3) 0 0;
    color: var(--bone-dim);
    font-size: var(--step--1);
    line-height: 1.5;
    max-width: var(--measure);
  }

  .figure__desc {
    margin-top: var(--space-2);
    max-width: var(--measure);
  }
  .figure__desc summary {
    cursor: pointer;
    color: var(--bone-dim);
    list-style-position: outside;
  }
  .figure__desc summary:hover {
    color: var(--bone);
  }
  .figure__desc p {
    margin-top: var(--space-2);
    color: var(--bone-dim);
    font-size: var(--step--1);
  }
</style>
